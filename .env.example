# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8500

# Frontend (local)
NEXT_PUBLIC_API_URL=http://localhost:8500

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:8600,https://lawind.ai,https://www.lawind.ai

# Production frontend env (set in Vercel dashboard)
# NEXT_PUBLIC_API_URL=https://api.lawind.ai

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lawind

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lawind-ai

# Auth (Clerk or Cognito)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
